# Tạo lại file .env:
#   cd AppEnglish
#   cp .env.example .env
# Rồi mở .env và điền giá trị thật (key không commit lên Git).
#
# --- Database ---
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/learning_english
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# --- JWT (chuỗi dài, ngẫu nhiên) ---
APP_JWT_SECRET=

# --- AWS (S3, Transcribe, …) ---
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=learning-english-bucket

# --- YouTube API (nếu dùng) ---
YOUTUBE_API_KEY=

# --- Azure Speech (nếu dùng) ---
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=southeastasia
AZURE_SPEECH_LOCALE=en-US
AZURE_SPEECH_TIMEOUT_SECONDS=20

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview
OPENAI_REALTIME_VOICE=alloy

# --- AI Chat (tùy chọn: custom endpoint) ---
APP_AI_CHAT_URL=
APP_AI_CHAT_API_KEY=
APP_AI_CHAT_MODEL=gpt-4o-mini

# --- Công cụ ---
IPA_ESPEAK_COMMAND=espeak-ng
FFMPEG_PATH=ffmpeg

# --- Kafka ---
SPRING_KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- Khác ---
APP_TEMP_DIR=temp
APP_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Ghi chú Docker Compose ---
# Nếu Spring chạy trong Docker cùng compose: đổi JDBC sang jdbc:postgresql://db:5432/...
# và Kafka sang kafka:29092 (xem docker-compose.yml).
