# Sao chép thành .env cho docker compose HOẶC chỉ dùng làm tham chiếu.
# QUAN TRỌNG: file .env của compose thường dùng hostname Docker (db, kafka).
# Nếu bạn `source .env` rồi chạy Spring trên máy → JDBC sẽ lỗi vì không resolve "db".
#
# --- Khi chạy Spring Boot trên máy (IDE / mvn) ---
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/learning_english
# SPRING_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
#
# --- Khi backend chạy TRONG docker-compose (cùng network) ---
# SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/learning_english
# SPRING_KAFKA_BOOTSTRAP_SERVERS=kafka:29092
